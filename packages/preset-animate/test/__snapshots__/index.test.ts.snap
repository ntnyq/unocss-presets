@keyframes unAnimationZoomOut {
from {
      opacity: 1;
    }

    50% {
      opacity: 0;
      transform: scale3d(0.3, 0.3, 0.3);
    }

    to {
      opacity: 0;
    }
}
.animation-zoom-out{animation-name: unAnimationZoomOut;}"
`;

